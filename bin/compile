#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

# fail fast
set -e

BP_DIR=$(cd $(dirname $0)/..; pwd) # absolute path
BIN_DIR=$BP_DIR/bin

# parse args
BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

echo "path BUILD_DIR: ${BUILD_DIR}"
ls -la $BUILD_DIR

JVM_COMMON_BUILDPACK=${JVM_COMMON_BUILDPACK:-"https://codon-buildpacks.s3.amazonaws.com/buildpacks/heroku/jvm-common.tgz"}
mkdir -p /tmp/jvm-common
curl --retry 3 --silent --location $JVM_COMMON_BUILDPACK | tar xzm -C /tmp/jvm-common --strip-components=1
. /tmp/jvm-common/bin/util
. /tmp/jvm-common/bin/java

install_java_with_overlay ${BUILD_DIR}

WILDFLY_VERSION="16.0.0.Final"
JBOSS_HOME=".jboss/wildfly-${WILDFLY_VERSION}"

cd $BUILD_DIR

mkdir -p .jboss

# The tarball is kept in Heroku's build cache so it is only downloaded once per app
WILDFLY_URL=${WILDFLY_URL:-"https://download.jboss.org/wildfly/${WILDFLY_VERSION}/wildfly-${WILDFLY_VERSION}.tar.gz"}
WILDFLY_TGZ="$CACHE_DIR/wildfly-${WILDFLY_VERSION}.tar.gz"
if [ -f "$WILDFLY_TGZ" ]; then
  echo "-----> using cached Wildfly ${WILDFLY_VERSION} from build cache"
else
  echo -n "-----> downloading Wildfly ${WILDFLY_VERSION}... "
  mkdir -p "$CACHE_DIR"
  # download to a temp name so an interrupted build never leaves a truncated file in the cache
  wget -q -O "$WILDFLY_TGZ.part" "$WILDFLY_URL"
  mv "$WILDFLY_TGZ.part" "$WILDFLY_TGZ"
  echo "downloaded"
fi

echo -n "-----> extracting Wildfly ${WILDFLY_VERSION}... "
tar xf "$WILDFLY_TGZ" -C .jboss
echo "extracted"

echo -n "-----> Deploying war file(s)... "
cp 05_myWMS-ear/target/*.ear $JBOSS_HOME/standalone/deployments/
echo "done"

# Get the absolute path of the buildpack directory
BP_DIR="$(cd "${0%/*}/.."; pwd)"
echo "absolute path: ${BP_DIR}"
cp $BP_DIR/postgresql-42.7.14.jar $JBOSS_HOME/standalone/deployments/postgresql.jar

# standalone.xml reads the datasource credentials at boot via ${env.JDBC_DATABASE_*}
# expressions. Those variables are exported on every dyno start by .profile.d/jdbc.sh,
# which jvm-common installed above (it parses Heroku's DATABASE_URL).
echo -n "-----> Installing standalone.xml... "
cp $BP_DIR/standalone.xml $JBOSS_HOME/standalone/configuration/standalone.xml
echo "done"

echo "-----> Creating configuration..."
if [ -f $BUILD_DIR/Procfile ]; then
  echo "        - using existing process types"
else
  cat << EOF > $BUILD_DIR/Procfile
web: \$JBOSS_HOME/bin/standalone.sh -b=0.0.0.0 -Djboss.http.port=\$PORT
EOF
fi

mkdir -p $BUILD_DIR/.profile.d
cat << EOF > $BUILD_DIR/.profile.d/jboss.sh
export JBOSS_HOME=${JBOSS_HOME}
# prevent WFLYLOG0078
# export JAVA_TOOL_OPTIONS="\${JAVA_TOOL_OPTIONS} -Djboss.modules.system.pkgs=org.jboss.logmanager"
# export JAVA_TOOL_OPTIONS="\${JAVA_TOOL_OPTIONS} -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
# export JAVA_TOOL_OPTIONS="\${JAVA_TOOL_OPTIONS} -Xbootclasspath/p:$JBOSS_HOME/modules/system/layers/base/org/jboss/logmanager/main/jboss-logmanager-2.0.4.Final.jar"
EOF
